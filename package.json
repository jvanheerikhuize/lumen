{
  "name": "lumen",
  "version": "1.0.0",
  "private": true,
  "description": "Single-binary Go + React 19 self-hosted streaming dashboard: free catalogs, anime, live TV, household & Kids profiles, and torrent streaming with on-the-fly ffmpeg conversion. Specs: https://jvanheerikhuize.github.io/lumen/",
  "homepage": "https://jvanheerikhuize.github.io/lumen/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jvanheerikhuize/lumen.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('node:fs').writeFileSync('web/dist/.gitkeep', '')\"",
    "start": "./bin/lumen",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "go test ./cmd/... ./internal/... ./web/... && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "spec:check": "python3 tools/spec.py check --strict",
    "spec:render": "python3 tools/spec.py render --format markdown && python3 tools/spec.py render --format gherkin",
    "spec:index": "python3 tools/spec.py index"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "lucide-react": "^1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vite": "^8.3.8"
  }
}
