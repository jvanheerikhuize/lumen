# Copy to .env and fill in what you need. Everything is optional.

# HTTP port the single binary listens on (default: 3000)
PORT=3000

# Directory for embedded SQLite state store (lumen.db) and state.json mirror
LUMEN_DATA_DIR=./data

# Extra metadata and trending lists from TMDB (free key: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Search your own Prowlarr and/or Jackett for every title
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=

# Set to 1 to allow Stremio addons hosted on your own network
LUMEN_ALLOW_PRIVATE_ADDONS=

# Internal port Lumen listens on when running behind a reverse proxy on 80/443 (defaults to PORT or 3000)
LUMEN_INTERNAL_PORT=

# Optional hardware-accelerated video transcoding: vaapi | nvenc | qsv | videotoolbox | none
LUMEN_HWACCEL=
